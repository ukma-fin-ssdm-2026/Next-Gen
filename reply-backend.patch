+"""Відповідь на повідомлення: `messages.reply_to_id` (ADR-005)."""
+
+import sqlalchemy as sa
+from alembic import op
+from sqlalchemy.dialects import postgresql
+
+revision = "0008_message_reply_to"
+down_revision = "0007_merge_reviews_chat"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    with op.batch_alter_table("messages") as batch:
+        batch.add_column(
+            sa.Column("reply_to_id", postgresql.UUID(as_uuid=True), nullable=True)
+        )
+        batch.create_foreign_key(
+            "fk_messages_reply_to_id",
+            "messages",
+            ["reply_to_id"],
+            ["message_id"],
+            ondelete="SET NULL",
+        )
+
+
+def downgrade() -> None:
+    with op.batch_alter_table("messages") as batch:
+        batch.drop_constraint("fk_messages_reply_to_id", type_="foreignkey")
+        batch.drop_column("reply_to_id")
diff --git a/docs/api/api-design.md b/docs/api/api-design.md
index 1f273c3..816c9d5 100644
--- a/docs/api/api-design.md
+++ b/docs/api/api-design.md
@@ -114,7 +114,8 @@
 - **Автентифікація й приватність:** усі 6 маршрутів чату вимагають дійсної серверної сесії (`require_current_user`, cookie `baraholka_session`). Анонімний запит чи підроблені `X-Actor-Id`/`X-Actor-Role` повертають `401 Unauthorized`; заблокований користувач — `403 Forbidden`. Клієнтські поля `sender_id`, `user_id`, `email`, `role`, `owner_id` у тілі запитів відхиляються (`extra="forbid"`, `422`). У жодній відповіді чату не передаються `email`, профільні контакти чи `Listing.contact` (у `other` лише `user_id`, `display_name`, `avatar_url`). Усі відповіді чату містять заголовок `Cache-Control: no-store`. Текст повідомлень і cookie не потрапляють до логів помилок чи журналу дій.
 - **Захист від IDOR (`SEC-003`):** спроба не-учасника (включно з `ADMIN`) прочитати повідомлення, надіслати повідомлення або позначити прочитаною чужу розмову повертає `404 Not Found` із тим самим тілом, що й для неіснуючої розмови.
 - **Початок розмови (`POST /api/v1/listings/{listing_id}/conversation`):** створює або знаходить єдину розмову між поточним користувачем і продавцем `ACTIVE`-оголошення та атомарно надсилає обов'язкове перше повідомлення з карткою оголошення (`201 Created`, якщо розмова створена вперше; `200 OK`, якщо розмова між парою вже існувала — навіть при старті з іншого оголошення чи у зворотному напрямку). Спроба написати самому собі повертає `403 Forbidden`. Подія `CONVERSATION_STARTED` фіксується в журналі дій користувачів лише при створенні нової розмови. У v1 немає початку розмови через довільний `/users/{id}` або публічного пошуку користувачів.
-- **Повідомлення, картка оголошення та курсори:** текст повідомлення валідується в межах 1–1000 символів після обрізання пробілів (без керівних і Unicode bidi-символів — інакше `422`) і повертається як звичайний рядок без перетворення посилань на HTML. У `POST /conversations/{conversation_id}/messages` необов'язковий `listing_id` приймається лише для `ACTIVE`-оголошення одного з учасників розмови; для чужого, знятого або неіснуючого оголошення повертається однаковий `404 Not Found`. Якщо раніше прикріплене оголошення згодом знято, картка повертає лише `available: false` («Оголошення знято») з порожніми `title`, `price`, `image_url`.
+- **Повідомлення, картка оголошення та курсори:** текст повідомлення валідується в межах 1–1000 символів після обрізання пробілів (без керівних, окрім переносу рядка, і Unicode bidi-символів — інакше `422`) і повертається як звичайний рядок без перетворення посилань на HTML. У `POST /conversations/{conversation_id}/messages` необов'язковий `listing_id` приймається лише для `ACTIVE`-оголошення одного з учасників розмови; для чужого, знятого або неіснуючого оголошення повертається однаковий `404 Not Found`. Якщо раніше прикріплене оголошення згодом знято, картка повертає лише `available: false` («Оголошення знято») з порожніми `title`, `price`, `image_url`.
+- **Відповідь на повідомлення:** `POST /conversations/{conversation_id}/messages` приймає необов'язкове `reply_to_id`. Воно має вказувати на повідомлення цієї ж розмови, інакше `422` (відповідь однакова для чужого й вигаданого id). Відповідь API містить `reply_to` — `{message_id, sender_id, is_own, body}` із текстом, скороченим до 140 символів, або `null`, якщо оригінал уже видалено.
 - **Курсорна пагінація і polling (`PERF-002`):** `GET /conversations` приймає `limit` (1–50, типово 20) і непрозорий `cursor`; `GET /conversations/{conversation_id}/messages` приймає `limit` (1–100, типово 50) та взаємовиключні непрозорі курсори `after` (polling раз на 5 с для отримання нових повідомлень за `<= 10 с`) або `before` (гортання історії назад). Одночасна передача `after` і `before`, а також пошкоджений або підроблений курсор повертають `422 Unprocessable Entity`.
 - **Непрочитані та ліміти (`429`):** `GET /conversations/unread-count` повертає лише `{"unread_count": N}`; `POST /conversations/{conversation_id}/read` повертає `204 No Content` і обнуляє непрочитані лише поточного учасника. Перевищення лімітів (`CHAT_MESSAGE_RATE_PER_MINUTE=30` за рухому хвилину або `CHAT_CONVERSATION_STARTS_PER_DAY=10` нових розмов за добу) повертає `429 Too Many Requests` із заголовком `Retry-After`.
 
