# Несекретна конфігурація лише для локальної розробки.
APP_ENV=development
DEV_AUTH_ENABLED=true

# Dummy-значення потрібні для спільної auth-конфігурації; вони не надсилаються Microsoft.
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000001
MICROSOFT_CLIENT_ID=baraholka-local-development
MICROSOFT_CLIENT_SECRET=local-development-not-a-secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_SECURE=false
