@startuml
title Baraholka NaUKMA - Sequence Diagram: Створення оголошення (UC-001)

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Продавець" as User
participant "React SPA" as SPA
participant "API Router" as Router
participant "Auth Service" as Auth
participant "Listing Service" as Listing
participant "Сховище зображень" as Storage
database "PostgreSQL" as DB

User -> SPA: Заповнює форму та тисне "Опублікувати"
activate SPA

SPA -> Router: POST /api/v1/listings\n(Authorization: Bearer <token>)
activate Router

Router -> Auth: validate_token(token)
activate Auth

alt Недійсний або прострочений токен
    Auth --> Router: Token invalid / expired
    Router --> SPA: 401 Unauthorized
    SPA --> User: Перенаправлення на сторінку входу
else Валідний токен
    Auth --> Router: UserPayload (user_id, role)
    deactivate Auth

    Router -> Listing: create_listing(user_id, listing_data, image)
    activate Listing

    Listing -> DB: check_user_active(user_id)
    activate DB
    DB --> Listing: is_blocked = false
    deactivate DB

    alt Обліковий запис заблоковано
        Listing --> Router: 403 Forbidden
        Router --> SPA: 403 Forbidden
        SPA --> User: Повідомлення про блокування
    else Користувач активний
        Listing -> Storage: upload_image(image_file)
        activate Storage
        Storage --> Listing: image_url
        deactivate Storage

        Listing -> DB: save_listing(listing_data, image_url)
        activate DB
        note over DB: Транзакційне збереження\nListing та ListingImage (ACID)
        DB --> Listing: Listing record
        deactivate DB

        Listing --> Router: 201 Created (ListingDTO)
        deactivate Listing

        Router --> SPA: 201 Created (JSON)
        SPA --> User: Повідомлення про успіх та перегляд оголошення
    end
end

deactivate Router
deactivate SPA

@enduml
