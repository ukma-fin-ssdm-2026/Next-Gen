@startuml
skinparam componentStyle uml2

title Component Diagram - Baraholka NaUKMA (Monolithic Client-Server)

package "Client Tier" {
    component "React SPA\n(Frontend)" as SPA <<Browser>>
}

cloud "Microsoft Entra ID\n(NaUKMA tenant)" as Entra <<IdentityProvider>>

package "Server Tier (FastAPI Monolith)" {
    interface "REST API" as RestAPI
    
    component "API Router" as Router <<Controller>>
    
    component "Auth Service" as AuthService <<Service>>
    component "Listing Service" as ListingService <<Service>>
    component "Moderation Service" as ModerationService <<Service>>
    component "Complaint Service" as ComplaintService <<Service>>
    component "Feedback Service" as FeedbackService <<Service>>
    component "Activity Log Service" as ActivityLogService <<Service>>
    component "Seller Review Service" as ReviewService <<Service>>
    component "Conversation Service" as ConversationService <<Service>>
    component "Message Report Service" as MessageReportService <<Service>>
    
    component "Data Access Layer\n(ORM)" as DAL <<Repository>>
}

package "Data Tier" {
    database "PostgreSQL" as DB <<Database>>
    storage "Image Storage\n(Local Docker Volume)" as ImageStorage <<Storage>>
}

' Connections
SPA ..> RestAPI : "HTTPS\n(JSON)"
note right of SPA
  Чат: polling 5 с (розмова), 30 с (список)
  ADR-005
end note
RestAPI - Router

Router --> AuthService
Router --> ListingService
Router --> ModerationService
Router --> ComplaintService
Router --> FeedbackService
Router --> ActivityLogService
Router --> ReviewService : "Rating, moderation, listing detail"
Router --> ConversationService : Conversation API
Router --> MessageReportService : Message report API
note right on link
  POST /conversations/{conversation_id}/messages/{message_id}/report
  Серверна сесія та перевірка участі в розмові
  GET /admin/message-reports
  POST /admin/message-reports/{report_id}/resolve
  Серверна сесія та require_moderator
end note

AuthService --> DAL
AuthService ..> Entra : "OIDC Authorization Code\nHTTPS"
ListingService --> DAL
ListingService --> ImageStorage : "Save/Delete WebP Images"
ListingService --> ActivityLogService : "Record User Actions"
ModerationService --> DAL
ComplaintService --> DAL
ComplaintService --> ActivityLogService : "Record Submit/Resolution"
FeedbackService --> DAL
FeedbackService --> ActivityLogService : "Record Submit/Resolution"
ActivityLogService --> DAL
ReviewService --> DAL : "Reviews and activity events"
ConversationService --> DAL
MessageReportService --> DAL : Reports, conversations, users
note bottom of MessageReportService
  Адміністратору доступний знімок
  оскарженого повідомлення через API скарг.
  Історія розмови доступна її учасникам.
  SEC-003 / ADR-005
end note
ConversationService --> ActivityLogService : "Record CONVERSATION_STARTED"

DAL ..> DB : "TCP/IP\n(SQL)"

' Нотатка «Використання ШІ»
' Доповнення (Євгеній Остапенко, SEC-003): Codex (OpenAI) допоміг показати API скарг і сервіс модерації.
' Потік звірено з src/api/routers/message_reports.py, src/api/deps.py та src/services/message_reports.py.
@enduml
