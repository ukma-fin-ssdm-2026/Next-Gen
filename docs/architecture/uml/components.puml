@startuml
skinparam componentStyle uml2

title Component Diagram - Baraholka NaUKMA (Monolithic Client-Server)

package "Client Tier" {
    component "React SPA\n(Frontend)" as SPA <<Browser>>
}

cloud "Microsoft Entra ID\n(NaUKMA tenant)" as Entra <<IdentityProvider>>

package "Server Tier (FastAPI Monolith)" {
    interface "REST API" as RestAPI
    
    component "API Router" as Router <<Controller>>
    
    component "Auth Service" as AuthService <<Service>>
    component "Listing Service" as ListingService <<Service>>
    component "Moderation Service" as ModerationService <<Service>>
    component "Complaint Service" as ComplaintService <<Service>>
    component "Feedback Service" as FeedbackService <<Service>>
    component "Activity Log Service" as ActivityLogService <<Service>>
    
    component "Data Access Layer\n(ORM)" as DAL <<Repository>>
}

package "Data Tier" {
    database "PostgreSQL" as DB <<Database>>
    storage "Image Storage\n(Local Docker Volume)" as ImageStorage <<Storage>>
}

' Connections
SPA ..> RestAPI : "HTTPS\n(JSON)"
RestAPI - Router

Router --> AuthService
Router --> ListingService
Router --> ModerationService
Router --> ComplaintService
Router --> FeedbackService
Router --> ActivityLogService

AuthService --> DAL
AuthService ..> Entra : "OIDC Authorization Code\nHTTPS"
ListingService --> DAL
ListingService --> ImageStorage : "Save/Delete WebP Images"
ListingService --> ActivityLogService : "Record User Actions"
ModerationService --> DAL
ComplaintService --> DAL
ComplaintService --> ActivityLogService : "Record Submit/Resolution"
FeedbackService --> DAL
FeedbackService --> ActivityLogService : "Record Submit/Resolution"
ActivityLogService --> DAL

DAL ..> DB : "TCP/IP\n(SQL)"

@enduml
