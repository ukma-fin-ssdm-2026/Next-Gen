@startuml
title Baraholka NaUKMA - Data Model

hide methods
hide stereotypes

legend right
  Жовтим позначено заплановані сутності
  (ADR-004, ADR-005); реалізація триває.
endlegend

entity "User" as user {
  * user_id : UUID <<PK>>
  --
  * tenant_id : UUID
  * entra_object_id : UUID
  * email : string <<personal data, unique>>
  * display_name : string <<personal data>>
  * role : enum
  * is_blocked : boolean
  * created_at : datetime
}

entity "Category" as category {
  * category_id : UUID <<PK>>
  --
  * name : string <<unique>>
  * is_active : boolean
}

entity "CategorySuggestion" as suggestion {
  * suggestion_id : UUID <<PK>>
  --
  * name : string
  * proposer_id : UUID <<FK>>
  * status : enum
  reason : text <<nullable>>
  category_id : UUID <<FK, nullable>>
  reviewed_by : UUID <<FK, nullable>>
  * created_at : datetime
  reviewed_at : datetime <<nullable>>
}

entity "Listing" as listing {
  * listing_id : UUID <<PK>>
  --
  * seller_id : UUID <<FK>>
  * category_id : UUID <<FK>>
  suggested_category_id : UUID <<FK, nullable>>
  * title : string
  * description : text
  * price : decimal
  * contact : string <<personal data>>
  * condition : enum
  * status : enum
  * created_at : datetime
  * updated_at : datetime
}

entity "ListingImage" as image {
  * image_id : UUID <<PK>>
  --
  * listing_id : UUID <<FK>>
  * image_url : string
  * display_order : integer
}

entity "ModerationAction" as moderation {
  * moderation_action_id : UUID <<PK>>
  --
  * moderator_id : UUID <<FK>>
  listing_id : UUID <<FK, nullable>>
  target_user_id : UUID <<FK, nullable>>
  suggestion_id : UUID <<FK, nullable>>
  * action_type : enum
  * reason : text
  * created_at : datetime
}

entity "Favorite" as favorite {
  * user_id : UUID <<PK, FK>>
  * listing_id : UUID <<PK, FK>>
  --
  * created_at : datetime
}

entity "Complaint" as complaint {
  * complaint_id : UUID <<PK>>
  --
  * listing_id : UUID <<FK>>
  * reporter_id : UUID <<FK>>
  * reason : enum
  * details : text
  * status : enum
  * created_at : datetime
  resolved_by : UUID <<FK, nullable>>
  resolved_at : datetime <<nullable>>
  * resolution_note : text
}

entity "FeedbackMessage" as feedback {
  * feedback_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * subject : string
  * message : text
  * status : enum
  * created_at : datetime
  resolved_by : UUID <<FK, nullable>>
  resolved_at : datetime <<nullable>>
}

entity "ActivityEvent" as activity {
  * event_id : UUID <<PK>>
  --
  * actor_id : UUID <<FK>>
  * actor_role : enum
  * action_type : enum
  listing_id : UUID <<nullable>>
  * details : string
  * created_at : datetime
}

entity "SellerReview" as review <<planned>> #FFF4D6;line:D9A441 {
  * review_id : UUID <<PK>>
  --
  * seller_id : UUID <<FK>>
  * author_id : UUID <<FK>>
  listing_id : UUID <<FK, nullable>>
  * rating : smallint
  * status : enum
  hidden_reason : text <<nullable>>
  hidden_by : UUID <<FK, nullable>>
  hidden_at : datetime <<nullable>>
  * created_at : datetime
  * updated_at : datetime
}

entity "Conversation" as conversation <<planned>> #FFF4D6;line:D9A441 {
  * conversation_id : UUID <<PK>>
  --
  * user_low_id : UUID <<FK>>
  * user_high_id : UUID <<FK>>
  * created_at : datetime
  * last_message_at : datetime
  low_last_read_at : datetime <<nullable>>
  high_last_read_at : datetime <<nullable>>
}

entity "Message" as message <<planned>> #FFF4D6;line:D9A441 {
  * message_id : UUID <<PK>>
  --
  * conversation_id : UUID <<FK>>
  * sender_id : UUID <<FK>>
  listing_id : UUID <<FK, nullable>>
  * body : text <<personal data>>
  * created_at : datetime
}

user ||--o{ listing : creates
category ||--o{ listing : categorizes
suggestion |o--o{ listing : suggested for
user ||--o{ suggestion : proposes
user |o--o{ suggestion : reviews
category |o--o| suggestion : created from
listing ||--|{ image : contains
user ||--o{ moderation : performs
user |o--o{ moderation : target user
listing |o--o{ moderation : target listing
suggestion |o--o{ moderation : target suggestion
user ||--o{ favorite : adds
listing ||--o{ favorite : is_favorited
user ||--o{ complaint : reports
user |o--o{ complaint : resolves
listing ||--o{ complaint : receives
user ||--o{ feedback : submits
user |o--o{ feedback : resolves
user ||--o{ activity : performs
listing |o..o{ activity : referenced by
user ||--o{ review : "is rated (seller)"
user ||--o{ review : "rates (author)"
user |o--o{ review : hides
listing |o--o{ review : context
user ||--o{ conversation : "participates (low)"
user ||--o{ conversation : "participates (high)"
conversation ||--|{ message : contains
user ||--o{ message : sends
listing |o--o{ message : mentioned in

note right of user
  role: USER | ADMIN
  email domain: @ukma.edu.ua
  UNIQUE (tenant_id, entra_object_id)
  no local password
end note

note right of listing
  condition: NEW | LIKE_NEW | GOOD | USED
  status: ACTIVE | WITHDRAWN |
          REMOVED_BY_MODERATOR
end note

note right of moderation
  action_type: WITHDRAW_LISTING |
               BLOCK_USER | UNBLOCK_USER |
               APPROVE_CATEGORY | REJECT_CATEGORY

  Exactly one target must be set:
  listing_id XOR target_user_id XOR suggestion_id
end note

note right of complaint
  reason: SPAM | FRAUD | PROHIBITED |
          INAPPROPRIATE | WRONG_CATEGORY | OTHER
  status: OPEN | RESOLVED | DISMISSED
  UNIQUE (listing_id, reporter_id)
end note

note right of feedback
  status: NEW | RESOLVED
end note

note right of activity
  Immutable audit event (FR-018)
  listing_id is a logical reference without FK
  INDEX (actor_role, created_at)
end note

note right of review
  status: VISIBLE | HIDDEN
  rating: 1..5 (CHECK)
  UNIQUE (author_id, seller_id)
  CHECK (author_id <> seller_id)
  INDEX (seller_id, status)
  ADR-004
end note

note right of conversation
  CHECK (user_low_id < user_high_id)
  UNIQUE (user_low_id, user_high_id)
  INDEX (user_low_id, last_message_at)
  INDEX (user_high_id, last_message_at)
  ADR-005
end note

note right of message
  body: 1-1000 chars, immutable
  listing_id: optional context,
  ON DELETE SET NULL
  INDEX (conversation_id, created_at)
  ADR-005
end note

@enduml
